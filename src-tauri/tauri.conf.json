{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "raise-your-butt",
  "version": "0.1.0",
  "identifier": "com.raiseyourbutt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "久坐提醒设置",
        "width": 380,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": true,
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focus": true
      },
      {
        "label": "overlay",
        "title": "",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/A_minimalist_pencil_drawing_il_2026-07-24T10-00-32.png"
    ]
  }
}
